{
  "name": "citadelpanel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "env:init": "bun run scripts/init-env.ts",
    "auth:migrate": "bunx @better-auth/cli migrate --config lib/server/control-plane/auth/betterAuth.migrate.ts -y",
    "db:migrate": "bun run scripts/migrate.ts",
    "migrate": "bun run auth:migrate && bun run db:migrate",
    "setup": "bun run env:init && bun run migrate",
    "rescue": "bun run scripts/rescue.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/api-key": "^1.6.25",
    "@better-auth/cli": "^1.4.21",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "monaco-editor": "^0.56.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.2.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
