# API-key credentials for the CitadelPanel E2E tests
#
# Copy to `.env.e2e` and fill in real API keys minted from the panel:
#   - a non-admin user's key  (tests the user side)
#   - an admin's key          (tests the admin side, incl. the key lifecycle)
#
# The `.env.e2e` file is gitignored. API keys are root-equivalent to their
# owner. Treat them like passwords. The suite creates + revokes its own
# throwaway key during the lifecycle test (using the admin key) and cleans up
# after itself; it never deletes the two keys you supply here.
#
# Run:  bun run test:e2e
#
# PANEL-SIDE REQUIREMENT: the suite issues hundreds of authenticated requests
# per key. The api-key plugin defaults to 10 requests / 24 h per key, which the
# suite would exhaust on the first run, so the panel must be started with
# rate limiting disabled. Add this to the PANEL's `.env` (not this file) and
# restart `bun run dev:frontend`:
#
#   RATE_LIMIT_ENABLED=false
#
# Production keeps the default (true); this only opts the dev panel out.

# Panel base URL. `bun run dev:frontend` serves on :3000 by default.
E2E_PANEL_URL=http://localhost:3000

# A NON-ADMIN account's API key. Used to assert the user-side surface and that
# user keys cannot reach /api/admin/* (403). Mint it from /settings → API keys.
E2E_USER_API_KEY=

# Optional: the owning account's email. When set, the suite asserts the key
# resolves to exactly this identity (the "key is its owner" model).
E2E_USER_EMAIL=

# An ADMIN account's API key. Used to assert the admin surface and to drive the
# create / disable / re-enable / revoke lifecycle.
E2E_ADMIN_API_KEY=

# Optional: the admin account's email.
E2E_ADMIN_EMAIL=
