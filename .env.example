# CitadelPanel configuration
#
# Copy to `.env` and fill in real values. Bun loads `.env` automatically.
# NEVER commit the resulting `.env` file.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Postgres control-plane database (the panel's own DB, not a node's game DB).
DATABASE_URL=postgres://citadel:change-me@localhost:5432/citadel

# --- Required secrets (the backend refuses to boot without these) -----------
# Panel-wide key used to derive the AES-256-GCM key that encrypts secrets at
# rest: node agent tokens, per-node DB admin passwords, provisioned database
# passwords, and secret server env values.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
# WARNING: rotating this makes all existing encrypted values unreadable.
PANEL_ENCRYPTION_KEY=

# Better Auth session/cookie signing secret.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# --- URLs -------------------------------------------------------------------
# Public base URL of the backend, used by Better Auth for callbacks.
BETTER_AUTH_URL=http://localhost:3001
# Frontend origin. This is the ONLY origin allowed through CORS, and it must be
# exact (not a wildcard) because auth uses credentialed cookie requests.
FRONTEND_URL=http://localhost:3000

# --- Bootstrap --------------------------------------------------------------
# When true, the first account to register becomes admin. This avoids shipping a
# default credential. Set to false once your admin account exists.
FIRST_USER_BECOMES_ADMIN=true

# --- Node agent -------------------------------------------------------------
# Token the panel presents to this machine's agent (the `agent` service in
# docker-compose.yml), and that the agent requires on every request.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
#
# SECURITY: this is root-equivalent for the node. The agent drives the Docker
# socket. Never expose an agent's port to the internet, and use a DIFFERENT
# token per node so one compromised node does not hand over the whole fleet.
AGENT_TOKEN=

# How long the panel waits on a node agent, in milliseconds. Slow operations
# (image pulls, container removal) use longer internal timeouts regardless.
NODE_API_TIMEOUT_MS=15000

# --- Direct console (browser → agent WebSocket) -----------------------------
# The live console opens a WebSocket straight from the browser to the node agent
# (no panel-held connection). The panel mints a short-lived capability token;
# the agent calls the panel back to validate it and audit each command.
#
# Panel base URL the agent calls back to for those validate/audit callbacks.
# Required when the agent serves browser-direct consoles. In the bundled
# docker-compose.yml this defaults to http://frontend:3000; on a remote node
# (docker-compose.agent.yml) set it to the panel's reachable base URL.
PANEL_URL=http://localhost:3000

# Optional TLS for the agent's HTTP/WS server. When BOTH are set, the agent
# serves HTTPS/WSS. Required for the browser-direct console when the panel is
# served over HTTPS. Browsers block ws:// from an https:// page (mixed content).
# Paths to PEM files inside the agent container, e.g. /certs/agent.pem.
AGENT_TLS_CERT=
AGENT_TLS_KEY=

# --- Container hardening (agent) ---------------------------------------------
# Optional OCI runtime for tenant + backup containers (Docker --runtime), e.g.
# "runsc" (gVisor) or "kata-runtime". Empty = the daemon default (runc). The
# runtime must be installed and registered on THIS node; the agent verifies it
# against the daemon at boot. Trades syscall performance for a stronger escape
# boundary. Enable user-namespace remapping first. See docs/node-hardening.md.
CONTAINER_RUNTIME=
# User-namespace remapping is configured on the Docker daemon (userns-remap in
# /etc/docker/daemon.json), NOT here. The agent auto-detects it and computes
# the uid/gid offset itself. Set these two only if auto-detection fails on an
# exotic daemon (the agent logs when it does); use the base from /etc/subuid.
# -1 means auto-detect. Run the agent as root on a remapped node.
USERNS_UID_OFFSET=-1
USERNS_GID_OFFSET=-1

# --- SFTP server (agent) -----------------------------------------------------
# The agent runs a custom SFTP server (ssh2) on its own port, alongside the
# HTTP/WS server. Each server's owner (or a subuser with the `files` permission)
# can mint per-(user,server) SFTP credentials from the panel; the agent
# validates them via a callback to the panel (so PANEL_URL is required for SFTP
# auth, same as the direct console). Connections are chrooted to that server's
# data directory.
# Set to 0 to disable the SFTP server entirely.
# Under docker compose this is the *published host* port: the agent's listener
# is fixed at 8022 inside the container, so set this to move it on the host and
# comment the mapping out to disable SFTP. See docs/docker.md.
SFTP_PORT=8022
# Path to the SFTP host key (RSA, PEM). Generated on first boot if missing and
# persisted so clients see a stable fingerprint. Defaults to a sibling of
# SERVER_DATA_ROOT.
SFTP_HOST_KEY_PATH=

# --- Shared node database (agent) ---------------------------------------------
# The agent creates a per-server database on the shared MariaDB container when a
# server owner provisions one. The container itself is created by the panel
# ("Set up database" on the node's admin page) or by `bun run setup-db` on the
# node; both use these names, so changing one after setup orphans the container.
# See docs/node-database.md.
NODE_DB_NETWORK=node_db_net
NODE_DB_CONTAINER=citadel-node-db
# Named volume holding MariaDB's data directory. Separate from the container so
# recreating the container keeps every server's database.
NODE_DB_VOLUME=citadel-node-db-data
# Pinned to a major version so nodes set up months apart agree on the dialect.
NODE_DB_IMAGE=mariadb:11

# --- Storage ----------------------------------------------------------------
# Root directory for per-server data, on the NODE. Read by the agent, not by the
# panel backend. The backend no longer touches server files at all.
SERVER_DATA_ROOT=/var/lib/citadel/servers

# Per-file upload size cap for the file manager, in bytes. Enforced by the
# panel (so an oversized upload is rejected before it reaches the node) and
# again by the agent. The agent's AGENT_MAX_UPLOAD_BYTES must be >= this.
# Default: 134217728 (128 MB).
UPLOAD_MAX_BYTES=134217728

# Agent-side cap on a single uploaded file or URL pull, in bytes. Default:
# 134217728 (128 MB). Keep >= UPLOAD_MAX_BYTES so the two agree.
AGENT_MAX_UPLOAD_BYTES=134217728

# --- Backups (agent) ---------------------------------------------------------
# The agent backs things up by running restic in a throwaway container, into the
# operator's S3 bucket. Two scopes, one encrypted repository each:
#   - per server: that server's data directory (files only)
#   - per node:   a SQL dump of every database provisioned on the node
# The second needs the node's MariaDB admin credential, so it is an admin
# operation rather than something a server owner triggers.
#
# The S3 destination, the two cron schedules, the per-subject snapshot limits and
# the storage quota are configured in the panel UI (Admin -> Backups), not here.
# Only the node-local knobs live in .env. See docs/backups.md.
#
# The restic image. Pinned rather than `latest`: a repository written by one
# restic version and read by another is a thing to opt into, not to discover
# after an image pull.
RESTIC_IMAGE=restic/restic:0.19.1

# Scratch space for database dumps on their way into a snapshot (and back out
# during a restore), plus restic's chunk cache. Deliberately a SIBLING of
# SERVER_DATA_ROOT, not a directory inside it: these dumps cover every database
# on the node, and a file under a server's own data directory would be readable
# through the file manager and over SFTP by anyone with the `files` permission.
# Defaults to <SERVER_DATA_ROOT>/../backup-staging.
BACKUP_STAGING_ROOT=

# Dedicated bridge network for the agent's own tooling containers (restic, the
# dump client). These hold the S3 credentials and a server's database password
# in their environment, so they never share a network with a tenant container.
BACKUP_NETWORK=citadel_backup_net

# Log lines the agent retains per backup job. The panel drains these as the job
# runs; the cap bounds a runaway restic's memory use on the node.
AGENT_MAX_BACKUP_LOG_LINES=2000

# --- Abuse detection (plan.md section 9) ------------------------------------
# Seconds between watcher sweeps across all nodes.
WATCHER_INTERVAL_SECONDS=60

# Cumulative heuristic score that writes a suspicious_activity row for review.
# Scoring detects abuse of the NODE (cryptomining); it does not police in-game
# behaviour. A single observation maxes out at 130.
SUSPICION_FLAG_THRESHOLD=60

# Optional emergency auto-suspend. OFF by default: heuristics have false
# positives, and suspending a legitimate heavy workload is costly. When enabled,
# a suspension also requires a high-confidence signal (an unambiguous stratum
# port), not just high resource usage.
# Keep this below 130 or auto-suspend can never trigger.
SUSPICION_AUTO_SUSPEND=false
SUSPICION_AUTO_SUSPEND_THRESHOLD=115

# --- Docker compose only ----------------------------------------------------
# Credentials for the bundled Postgres container.
POSTGRES_USER=citadel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=citadel
