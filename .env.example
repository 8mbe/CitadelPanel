# CitadelPanel configuration
#
# Copy to `.env` and fill in real values. Bun loads `.env` automatically.
# NEVER commit the resulting `.env` file.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Postgres control-plane database (the panel's own DB, not a node's game DB).
DATABASE_URL=postgres://citadel:change-me@localhost:5432/citadel

# --- Secrets (REQUIRED — the backend refuses to boot without these) ---------
# Panel-wide key used to derive the AES-256-GCM key that encrypts secrets at
# rest: node agent tokens, per-node DB admin passwords, provisioned database
# passwords, and secret server env values.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
# WARNING: rotating this makes all existing encrypted values unreadable.
PANEL_ENCRYPTION_KEY=

# Better Auth session/cookie signing secret.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# --- URLs -------------------------------------------------------------------
# Public base URL of the backend, used by Better Auth for callbacks.
BETTER_AUTH_URL=http://localhost:3001
# Frontend origin. This is the ONLY origin allowed through CORS, and it must be
# exact (not a wildcard) because auth uses credentialed cookie requests.
FRONTEND_URL=http://localhost:3000

# --- Bootstrap --------------------------------------------------------------
# When true, the first account to register becomes admin. This avoids shipping a
# default credential. Set to false once your admin account exists.
FIRST_USER_BECOMES_ADMIN=true

# --- Node agent -------------------------------------------------------------
# Token the panel presents to this machine's agent (the `agent` service in
# docker-compose.yml), and that the agent requires on every request.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
#
# SECURITY: this is root-equivalent for the node — the agent drives the Docker
# socket. Never expose an agent's port to the internet, and use a DIFFERENT
# token per node so one compromised node does not hand over the whole fleet.
AGENT_TOKEN=

# How long the panel waits on a node agent, in milliseconds. Slow operations
# (image pulls, container removal) use longer internal timeouts regardless.
NODE_API_TIMEOUT_MS=15000

# --- Shared node database (agent) ---------------------------------------------
# The agent creates a per-server database on the shared MariaDB container when
# a server owner provisions one. The network and container are created by
# `bun run setup-db` on the node; these names must match what that script used.
NODE_DB_NETWORK=node_db_net
NODE_DB_CONTAINER=citadel-node-db

# --- Storage ----------------------------------------------------------------
# Root directory for per-server data, on the NODE. Read by the agent, not by the
# panel backend — the backend no longer touches server files at all.
SERVER_DATA_ROOT=/var/lib/citadel/servers

# Per-file upload size cap for the file manager, in bytes. Enforced by the
# panel (so an oversized upload is rejected before it reaches the node) and
# again by the agent. The agent's AGENT_MAX_UPLOAD_BYTES must be >= this.
# Default: 134217728 (128 MB).
UPLOAD_MAX_BYTES=134217728

# Agent-side cap on a single uploaded file or URL pull, in bytes. Default:
# 134217728 (128 MB). Keep >= UPLOAD_MAX_BYTES so the two agree.
AGENT_MAX_UPLOAD_BYTES=134217728

# --- Abuse detection (plan.md section 9) ------------------------------------
# Seconds between watcher sweeps across all nodes.
WATCHER_INTERVAL_SECONDS=60

# Cumulative heuristic score that writes a suspicious_activity row for review.
# Scoring detects abuse of the NODE (cryptomining); it does not police in-game
# behaviour. A single observation maxes out at 130.
SUSPICION_FLAG_THRESHOLD=60

# Optional emergency auto-suspend. OFF by default: heuristics have false
# positives, and suspending a legitimate heavy workload is costly. When enabled,
# a suspension also requires a high-confidence signal (an unambiguous stratum
# port), not just high resource usage.
# Keep this below 130 or auto-suspend can never trigger.
SUSPICION_AUTO_SUSPEND=false
SUSPICION_AUTO_SUSPEND_THRESHOLD=115

# --- Docker compose only ----------------------------------------------------
# Credentials for the bundled Postgres container.
POSTGRES_USER=citadel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=citadel
