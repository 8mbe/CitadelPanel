# Build context for both images is the repository root (the workspace lockfile
# lives here). Keep it to source + manifests.

# Only revision pointers enter the build, never Git config, credentials, or objects.
.git/**
.gitignore
**/node_modules
**/.next
out
dist
build
*.tsbuildinfo

# Secrets never enter an image layer. Compose passes them in as environment.
.env
.env.*
**/.env
**/.env.*
certs/
*.pem
*.key
*.crt

# Not needed to build or run.
docs/
e2e/
plan.md
*.md
!apps/*/README.md
data/
*.log
.zcode
.vscode
.idea

# Keep these last so a branch named build or docs is still readable.
!.git/HEAD
!.git/refs/
!.git/refs/**
!.git/packed-refs
